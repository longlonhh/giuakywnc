# ============================================================
# CÂU 3.1 - KẾT NỐI CSDL (chọn MỘT trong hai phương án bên dưới)
# ============================================================

# ---------- PHƯƠNG ÁN 1: PostgreSQL Local (Docker) ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=library_db
DB_SSL=false

# ---------- PHƯƠNG ÁN 2: Aiven for PostgreSQL ----------
# Tạo dịch vụ miễn phí tại https://aiven.io/ -> copy các tham số
# trong mục "Connection information" rồi thay thế bên dưới.
# DB_HOST=pg-xxxxxxxx-xxxx.a.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_NAME=defaultdb
# DB_SSL=true

# Cổng chạy ứng dụng NestJS
PORT=3000
